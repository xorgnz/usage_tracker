# Copy this file to .env in the project root.
# Only this file's values and application defaults determine these settings.
# Exported PORT and CLAUDE_DIRECTORY values are ignored by ApplicationConfig.
# Missing .env or omitted keys use the defaults below; empty values are invalid.
#
# Port: integer from 1 through 65535. Default: 5173.
PORT=5173
#
# Claude Code directory. Default: ~/.claude.
# Use paths accessible to the OS running Node. Relative paths resolve from the project root.
# Windows can access WSL through a mapped drive, for example Y:/home/xorgnz/.claude.
# ~ and ~/ resolve from the current OS account's home directory.
# Quote paths containing # or surrounding whitespace.
# Values are literal: shell variables such as $HOME are not expanded.
# A missing, non-directory, or inaccessible path is reported as unavailable.
CLAUDE_DIRECTORY=~/.claude
#
# npm run dev reads these settings at startup; restart after changing .env.
