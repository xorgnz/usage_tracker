{
    "name": "usage_tracker",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Local Claude Code session monitoring and analysis.",
    "engines": {
        "node": "^22.12.0 || >=24.0.0"
    },
    "scripts": {
        "dev": "vite dev",
        "prepare": "svelte-kit sync",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "test": "tsc --project tests/tsconfig.json && node --import ./tests/register.mjs --test tests/*.test.ts"
    },
    "devDependencies": {
        "@sveltejs/kit": "3.1.0",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@types/node": "24.19.2",
        "svelte": "5.57.2",
        "svelte-check": "4.7.6",
        "typescript": "6.0.3",
        "vite": "8.3.4"
    }
}
