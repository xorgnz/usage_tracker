{
    "extends": "$app/tsconfig",
    "compilerOptions": {
        "strict": true,
        "allowJs": true,
        "checkJs": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    "include": [
        "src",
        "vite.config.ts"
    ],
    "exclude": [
        "src/service-worker",
        "node_modules"
    ]
}
